# Backend environment variables — copy to .env and fill in real values

# PostgreSQL connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5432/batdongsan?schema=public

# NestJS application port
PORT=3001

# Frontend origin for CORS (comma-separated for multiple origins)
CORS_ORIGIN=http://localhost:3000

# JWT secret — use a long, random string in production
JWT_SECRET=CHANGE_ME_USE_A_LONG_RANDOM_STRING_HERE

# JWT expiry for access tokens
JWT_EXPIRES_IN=15m

# JWT expiry for refresh tokens
JWT_REFRESH_EXPIRES_IN=7d

# Node environment
NODE_ENV=development